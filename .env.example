# Copy to .env.local for local development. Never commit .env.local.

# Vercel AI Gateway key. Required only for `npm run record` and for live mode
# (LIVE_MODE_ENABLED=true). Replay mode (the default) needs no key at all.
AI_GATEWAY_API_KEY=

# Set to "true" to expose the Live toggle and the live model-call API routes.
# Server-side only; never read from a client component.
LIVE_MODE_ENABLED=false

# Frozen evaluation clock. Nothing in the pipeline calls Date.now() — this is
# the only source of "now" for eval runs and the default ledger view.
EVAL_AS_OF=2026-07-24T23:59:59+05:30

# "file" for local dev (survives restart) or "memory" (Vercel default, does not).
LEDGER_STORE=file
