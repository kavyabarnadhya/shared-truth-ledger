{
  "name": "shared-truth-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared-truth ledger over a team's Slack and Gmail: extracts claims into persistent state and surfaces incompatible live claims before they reach execution.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run gen:bundles && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "eval": "node --experimental-strip-types scripts/eval.ts",
    "eval:live": "node --experimental-strip-types scripts/eval.ts --mode=live",
    "eval:compare": "node --experimental-strip-types scripts/eval.ts --config=free --diff-scope",
    "record": "node --experimental-strip-types scripts/record.ts && npm run gen:bundles",
    "gen:bundles": "node --experimental-strip-types scripts/generate-bundles.ts",
    "freeze:baseline": "node --experimental-strip-types scripts/freeze-baseline.ts",
    "validate:corpus": "node --experimental-strip-types scripts/validate-corpus.ts",
    "check:core-purity": "node --experimental-strip-types scripts/check-core-purity.ts",
    "check:no-key-in-bundle": "node --experimental-strip-types scripts/check-no-key-in-bundle.ts",
    "mcp": "node --experimental-strip-types mcp-server/src/index.ts"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "@eslint/eslintrc": "^3.2.0"
  }
}
